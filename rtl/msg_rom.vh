end

// captured only in the 2nd PREP cycle: {kind, idx} -> rom_*_r is a 2-cycle path
// (see set_multicycle_path in the XDC)
always @(posedge clk) if (rom_ce) begin rom_lit_r <= rom_lit; rom_fld_r <= rom_fld; end

// stage 2: field characters
always @(*) begin
    case (rom_fld_r)
        0: ch = rom_lit_r;
        1: ch = asc(c_ev_t);
        2: ch = asc(c_ev_o);
        3: ch = !c_tok ? 8'h20 : c_tneg ? "-" : "+";
        4: ch = c_tok ? asc(c_tt) : "-";
        5: ch = c_tok ? asc(c_to) : "-";
        6: ch = c_tok ? asc(c_tf) : "-";
        7: ch = asc(c_th_t);
        8: ch = asc(c_th_o);
        9: ch = asc(c_du_h);
        10: ch = asc(c_du_t);
        11: ch = asc(c_du_o);
        12: ch = (c_light) ? "1" : "0";
        13: ch = (c_manual) ? "M" : "A";
        14: ch = (c_manual) ? "A" : "U";
        15: ch = (c_manual) ? "N" : "T";
        16: ch = (c_manual) ? "U" : "O";
        17: ch = (c_manual) ? "A" : 8'h20;
        18: ch = (c_manual) ? "L" : 8'h20;
        19: ch = (c_eco) ? "1" : "0";
        20: ch = (c_sec == SEC_EXIT) ? "E" : (c_sec == SEC_ARMED) ? "A" : (c_sec == SEC_ENTRY) ? "E" : (c_sec == SEC_ALARM) ? "A" : "D";
        21: ch = (c_sec == SEC_EXIT) ? "X" : (c_sec == SEC_ARMED) ? "R" : (c_sec == SEC_ENTRY) ? "N" : (c_sec == SEC_ALARM) ? "L" : "I";
        22: ch = (c_sec == SEC_EXIT) ? "I" : (c_sec == SEC_ARMED) ? "M" : (c_sec == SEC_ENTRY) ? "T" : (c_sec == SEC_ALARM) ? "A" : "S";
        23: ch = (c_sec == SEC_EXIT) ? "T" : (c_sec == SEC_ARMED) ? "E" : (c_sec == SEC_ENTRY) ? "R" : (c_sec == SEC_ALARM) ? "R" : "A";
        24: ch = (c_sec == SEC_EXIT) ? 8'h20 : (c_sec == SEC_ARMED) ? "D" : (c_sec == SEC_ENTRY) ? "Y" : (c_sec == SEC_ALARM) ? "M" : "R";
        25: ch = (c_sec == SEC_EXIT) ? 8'h20 : (c_sec == SEC_ARMED) ? 8'h20 : (c_sec == SEC_ENTRY) ? 8'h20 : (c_sec == SEC_ALARM) ? 8'h20 : "M";
        26: ch = (c_sec == SEC_EXIT) ? 8'h20 : (c_sec == SEC_ARMED) ? 8'h20 : (c_sec == SEC_ENTRY) ? 8'h20 : (c_sec == SEC_ALARM) ? 8'h20 : "E";
        27: ch = (c_sec == SEC_EXIT) ? 8'h20 : (c_sec == SEC_ARMED) ? 8'h20 : (c_sec == SEC_ENTRY) ? 8'h20 : (c_sec == SEC_ALARM) ? 8'h20 : "D";
        28: ch = (c_gas) ? "1" : "0";
        29: ch = (c_occ) ? "1" : "0";
        30: ch = (c_pred) ? "1" : "0";
        31: ch = (c_fault) ? "1" : "0";
        32: ch = asc(c_hh_t);
        33: ch = asc(c_hh_o);
        34: ch = asc(c_mm_t);
        35: ch = asc(c_mm_o);
        36: ch = asc(c_dy_h);
        37: ch = asc(c_dy_t);
        38: ch = asc(c_dy_o);
        39: ch = !c_ail ? "-" : c_aio ? "1" : "0";
        40: ch = c_ail ? asc(c_ap_h) : "-";
        41: ch = c_ail ? asc(c_ap_t) : "-";
        42: ch = c_ail ? asc(c_ap_o) : "-";
        43: ch = asc(ps_h);
        44: ch = asc(ps_t);
        45: ch = asc(ps_o);
        46: ch = (c_xo) ? "1" : "0";
        47: ch = asc(c_xp_h);
        48: ch = asc(c_xp_t);
        49: ch = asc(c_xp_o);
        50: ch = asc(fan_bcd[51:48]);
        51: ch = asc(fan_bcd[47:44]);
        52: ch = asc(fan_bcd[43:40]);
        53: ch = asc(fan_bcd[39:36]);
        54: ch = asc(fan_bcd[35:32]);
        55: ch = asc(fan_bcd[31:28]);
        56: ch = asc(fan_bcd[27:24]);
        57: ch = asc(fan_bcd[23:20]);
        58: ch = asc(fan_bcd[19:16]);
        59: ch = asc(fan_bcd[15:12]);
        60: ch = asc(light_bcd[51:48]);
        61: ch = asc(light_bcd[47:44]);
        62: ch = asc(light_bcd[43:40]);
        63: ch = asc(light_bcd[39:36]);
        64: ch = asc(light_bcd[35:32]);
        65: ch = asc(light_bcd[31:28]);
        66: ch = asc(light_bcd[27:24]);
        67: ch = asc(light_bcd[23:20]);
        68: ch = asc(light_bcd[19:16]);
        69: ch = asc(light_bcd[15:12]);
        default: ch = 8'h20;
    endcase
end

// profile slot (hour) whose score is printed at this character position
always @(*) begin
    pj = 5'd0;
    if (kind == K_PROFILE)
