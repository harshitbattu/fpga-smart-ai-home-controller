            8'd184: rom_lit = 8'h0D;
            8'd185: rom_lit = 8'h0A;
            default: ;
        endcase
    end
    K_AI: begin  // AI OCC=# P=###%
        len = 8'd17;
        case (idx)
            8'd0: rom_lit = "A";
            8'd1: rom_lit = "I";
            8'd2: rom_lit = 8'h20;
            8'd3: rom_lit = "O";
            8'd4: rom_lit = "C";
