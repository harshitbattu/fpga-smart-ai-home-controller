            default: ;
        endcase
    end
    K_ENERGY: begin  // ENERGY FAN=######.####Wh LIGHT=######.####Wh
        len = 8'd46;
        case (idx)
            8'd0: rom_lit = "E";
            8'd1: rom_lit = "N";
            8'd2: rom_lit = "E";
